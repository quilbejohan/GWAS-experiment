  scale_shape_manual(values = c("Yes" = 16, "No" = 15)) +
  labs(x = "log2 fold change (Alt vs Ref)", y = "-log10(q value)") +
  theme_minimal()

# ============================================================
# 2E. Combined Utobara LORE1 + haplotype analysis
# ============================================================

df_lore1 <- read.csv("otu_table_Utobara_LORE1.csv", header = TRUE, row.names = 1, sep = ";", dec = ".")
df_haplotype <- read.csv("otu_table_Utobara_Haplotype.csv", header = TRUE, row.names = 1, sep = ",", dec = ".")
metadata_combined <- read.csv("metadata_combined.csv", header = TRUE, row.names = 1, sep = ";", dec = ".")

common_columns <- intersect(colnames(df_lore1), colnames(df_haplotype))
df_lore1 <- df_lore1[, common_columns, drop = FALSE]
df_haplotype <- df_haplotype[, common_columns, drop = FALSE]

combined_df <- rbind(df_lore1, df_haplotype)
combined_matrix <- as.matrix(t(combined_df))

combined_phy <- phyloseq(
  otu_table(combined_matrix, taxa_are_rows = TRUE),
  sample_data(metadata_combined)
)

sample_data(combined_phy)$Sample_ID <- rownames(sample_data(combined_phy))

combined_phy <- filter_rarefy_phyloseq(
  combined_phy,
  sample_threshold = 5000,
  subset_expr = "Soil %in% 'Utobara'",
  rngseed = rarefaction_seed
)

combined_phy <- subset_phyloseq(combined_phy, Compartment == "Rhizosphere")
combined_phy <- subset_phyloseq(combined_phy, !(Genotype %in% c("CFI1", "CFI2")))
combined_phy <- remove_named_sample(
  combined_phy,
  sample_column = "Sample_name",
  sample_name = "NLEAP1_1_Utobara_Rhizosphere"
)

combined_mds <- make_mds_table(combined_phy)

ggplot(combined_mds, aes(x = MDS1, y = MDS2, color = State, shape = Experiment)) +
  geom_point(size = 8, alpha = 0.8) +
  scale_color_manual(values = c(
    "Ref_Ref" = "gray20",
    "Alt_Ref" = "firebrick2",
    "Ref_Alt" = "orchid2",
    "roomie1-1" = "dodgerblue",
    "roomie1-2" = "springgreen2"
  )) +
  scale_shape_manual(values = c("LORE1" = 16, "HAPLOTYPE" = 15)) +
  labs(title = "Rhizosphere Utobara integrated", x = "MDS1", y = "MDS2") +
  theme_minimal()

combined_stats_roomie <- run_permanova_manova(
  subset(combined_mds, Genotype2 %in% c("Gifu", "roomie1")),
  formula_str = "Genotype2"
)

combined_stats_background <- run_permanova_manova(
  subset(combined_mds, State2 %in% c("Ref", "LORE1", "Alt")),
  formula_str = "State2"
)

combined_stats_detailed <- run_permanova_manova(
  subset(combined_mds, State %in% c("Ref_Ref", "roomie1-1", "roomie1-2", "Ref_Alt", "Alt_Ref")),
  formula_str = "State"
)

combined_stats_multivar <- adonis2(
  vegdist(subset(combined_mds, State %in% c("Ref_Ref", "roomie1-1", "roomie1-2", "Ref_Alt", "Alt_Ref"))[, c("MDS1", "MDS2")], method = "euclidean") ~ State2 + Genotype2,
  data = subset(combined_mds, State %in% c("Ref_Ref", "roomie1-1", "roomie1-2", "Ref_Alt", "Alt_Ref")),
  permutations = permanova_nperm
)
