# ============================================================
# 02. Microbiome validation analyses
# ============================================================
# Purpose:
#   Run the downstream microbiome analyses used for:
#     1. SynCom LORE1 experiment
#     2. Utobara natural-soil LORE1 experiment
#     3. Utobara natural-soil haplotype experiment
#     4. Combined LORE1 + haplotype comparison
#
# Required input files:
#   - dada2_LjRootnames_SynCom_LORE1.csv
#   - metadata_SC_LORE1.csv
#   - otu_table_Utobara_LORE1.csv
#   - metadata_Utobara_LORE1.csv
#   - otu_table_Utobara_Haplotype.csv
#   - metadata_Utobara_Haplotype.csv
#   - metadata_combined.csv
#
# Notes:
#   - This script starts from processed count tables and metadata.
#   - It reproduces ordination, PERMANOVA / pairwise MANOVA,
#     ANCOM-BC, and figure-oriented abundance summaries.
# ============================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(ggplot2)
  library(ggrepel)
  library(ANCOMBC)
  library(vegan)
  library(phyloseq)
  library(DESeq2)
  library(RVAideMemoire)
  library(reshape2)
})

# -----------------------------
# Global parameters
# -----------------------------
rarefaction_seed <- 42
permanova_nperm <- 999

# -----------------------------
# Helper functions
# -----------------------------
load_phyloseq_table <- function(count_file,
                                metadata_file,
                                count_sep = ",",
                                metadata_sep = ";",
                                transpose_counts = FALSE,
                                remove_taxa = NULL) {
  counts <- read.csv(count_file, header = TRUE, row.names = 1,
                     sep = count_sep, dec = ".", check.names = FALSE)
  metadata <- read.csv(metadata_file, header = TRUE, row.names = 1,
                       sep = metadata_sep, dec = ".", check.names = FALSE)

  count_matrix <- as.matrix(counts)
  if (transpose_counts) {
    count_matrix <- t(count_matrix)
  }

  if (!is.null(remove_taxa)) {
    count_matrix <- count_matrix[!rownames(count_matrix) %in% remove_taxa, , drop = FALSE]
  }

  physeq <- phyloseq(
    otu_table(count_matrix, taxa_are_rows = TRUE),
    sample_data(metadata)
  )
  sample_data(physeq)$Sample_ID <- rownames(sample_data(physeq))
  physeq
}

filter_rarefy_phyloseq <- function(physeq,
                                   sample_threshold = NULL,
                                   taxon_threshold = NULL,
                                   subset_expr = NULL,
                                   rngseed = 42) {
  phy_out <- physeq

  if (!is.null(sample_threshold)) {
    keep_samples <- sample_sums(phy_out) >= sample_threshold
    phy_out <- prune_samples(keep_samples, phy_out)
  }

  if (!is.null(taxon_threshold)) {
    keep_taxa <- taxa_sums(phy_out) >= taxon_threshold
    phy_out <- prune_taxa(keep_taxa, phy_out)
  }

  if (!is.null(subset_expr)) {
    phy_out <- subset_samples(phy_out, eval(parse(text = subset_expr)))
  }

  min_depth <- min(sample_sums(phy_out))
  rarefy_even_depth(phy_out, rngseed = rngseed, sample.size = min_depth, verbose = FALSE)
}

subset_phyloseq <- function(physeq, ...) {
  subset_samples(physeq, ...)
}

remove_named_sample <- function(physeq, sample_column, sample_name) {
  subset_samples(physeq, get(sample_column) != sample_name)
}

make_mds_table <- function(physeq, distance_method = "bray") {
  distance_matrix <- phyloseq::distance(physeq, method = distance_method, weighted = TRUE)
  mds_result <- cmdscale(distance_matrix, k = 2)

  out <- data.frame(
    MDS1 = mds_result[, 1],
    MDS2 = mds_result[, 2]
  )

  sample_df <- as.data.frame(sample_data(physeq))
  cbind(out, sample_df[rownames(out), , drop = FALSE])
}

plot_mds <- function(mds_df, color_var, shape_var = NULL,
                     colors = NULL, shapes = NULL,
                     title = NULL, point_size = 8) {
  p <- ggplot(mds_df, aes_string(x = "MDS1", y = "MDS2", color = color_var, shape = shape_var)) +
    geom_point(size = point_size, alpha = 0.9) +
    labs(title = title, x = "MDS1", y = "MDS2") +
    theme_minimal() +
    theme(
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      axis.line = element_line(linewidth = 0.5, color = "black"),
      axis.text = element_text(size = 14),
      legend.title = element_blank(),
      legend.text = element_text(size = 18, color = "black"),
      axis.title = element_text(size = 14),
      plot.title = element_text(size = 16)
    )

  if (!is.null(colors)) {
    p <- p + scale_color_manual(values = colors)
  }
  if (!is.null(shapes)) {
    p <- p + scale_shape_manual(values = shapes)
  }

  p
}

run_permanova_manova <- function(mds_df, formula_str) {
  dist_matrix <- vegdist(mds_df[, c("MDS1", "MDS2")], method = "euclidean")
  formula_obj <- as.formula(paste("dist_matrix ~", formula_str))

  permanova_res <- adonis2(formula_obj, data = mds_df, permutations = permanova_nperm)

  grouping_var <- all.vars(as.formula(paste("~", formula_str)))[1]
  manova_res <- pairwise.perm.manova(dist_matrix, mds_df[[grouping_var]], nperm = permanova_nperm)

  list(permanova = permanova_res, manova = manova_res)
}

run_ancombc2 <- function(physeq, formula_var, group_var, tax_level = "Species") {
  ancombc2(
    data = physeq,
    tax_level = tax_level,
    fix_formula = formula_var,
    p_adj_method = "holm",
    prv_cut = 0.10,
    lib_cut = 1000,
    group = group_var,
    struc_zero = TRUE,
    neg_lb = TRUE,
    alpha = 0.05,
    global = TRUE,
    n_cl = 1,
    verbose = TRUE,
    dunnet = TRUE
  )
}

make_volcano_df <- function(ancom_res, q_col, lfc_col) {
  res <- ancom_res$res
  res[[paste0("log_", q_col)]] <- -log10(res[[q_col]])
  res$significant <- ifelse(res[[q_col]] < 0.05, "Yes", "No")
  res
}

plot_volcano <- function(res_df, x_col, y_col, label_col = "taxon",
                         sig_col = "significant",
                         title = "Volcano Plot",
                         xlab = NULL, ylab = NULL) {
  ggplot(res_df, aes_string(x = x_col, y = y_col, color = sig_col, label = label_col)) +
    geom_point(size = 5, alpha = 0.8) +
    geom_text_repel(
      data = subset(res_df, significant == "Yes"),
      box.padding = 0.5,
      point.padding = 0.1,
      segment.alpha = 0,
      color = "black",
      size = 3
    ) +
    scale_color_manual(values = c("No" = "gray50", "Yes" = "firebrick3")) +
    labs(title = title, x = xlab, y = ylab) +
    theme_minimal()
}

melt_phyloseq_abundance <- function(physeq) {
  physeq_data <- as.data.frame(otu_table(physeq))
  physeq_data$Taxa <- rownames(physeq_data)

  melted <- reshape2::melt(
    physeq_data,
    id.vars = "Taxa",
    variable.name = "Sample_ID",
    value.name = "Abundance"
  )

  melted <- melted[melted$Sample_ID != "Sample_name", , drop = FALSE]
  melted$Abundance <- as.numeric(melted$Abundance)
  melted
}

summarise_replicate_abundance <- function(melted_df, replicate_list) {
  melted_df %>%
    filter(Sample_ID %in% unlist(replicate_list)) %>%
    group_by(
      Taxa,
      Group = case_when(
        !!!lapply(names(replicate_list), function(grp) {
          rlang::expr(Sample_ID %in% !!replicate_list[[grp]] ~ !!grp)
        })
      )
    ) %>%
    summarize(Average_Abundance = mean(Abundance), .groups = "drop")
}

plot_relative_abundance <- function(df, x_var = "Group", y_var = "Average_Abundance",
                                    fill_var = "Taxa", title = NULL, flip = FALSE) {
  p <- ggplot(df, aes_string(x = x_var, y = y_var, fill = fill_var)) +
    geom_bar(stat = "identity", position = "fill", color = "gray23", width = 0.9) +
    labs(y = "Relative abundance", title = title) +
    theme_minimal() +
    theme(
      axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size = 8),
      axis.text.y = element_text(size = 12),
      plot.background = element_rect(fill = "gray98"),
      axis.line = element_line(color = "black"),
      axis.title.y = element_blank(),
      axis.text = element_text(color = "black"),
      axis.title = element_text(color = "black"),
      plot.title = element_text(color = "black"),
      legend.position = "none"
    )

  if (flip) {
    p <- p + coord_flip()
  }
  p
}

