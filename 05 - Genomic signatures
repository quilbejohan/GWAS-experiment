  accession_meta <- accession_meta %>% rename(accession = X)
}

accession_meta <- accession_meta %>%
  mutate(
    accession = as.character(accession),
    lat = as.numeric(lat)
  )

sample_cols <- setdiff(names(SNP_matrix), c("CHR", "POS", "snp_id"))

accession_meta <- accession_meta %>%
  filter(accession %in% sample_cols)

# ============================================================
# 5A. Scatter plots
# ============================================================

plot_maf_fst_auc <- function(df, title) {
  ggplot(df, aes(x = pmax(MAF, 0.05), y = Fst_pop, color = AUC_LOESS)) +
    geom_point(alpha = 0.7, size = 3.5) +
    geom_smooth(
      method = "lm",
      se = TRUE,
      color = "black",
      linewidth = 1.2
    ) +
    scale_color_viridis_c(
      option = "plasma",
      limits = c(0, 1),
      breaks = c(0, 0.5, 1)
    ) +
    coord_cartesian(xlim = c(0.05, 0.5), ylim = c(0, 1)) +
    theme_minimal(base_size = 13) +
    labs(
      title = title,
      x = "MAF",
      y = "FST (North vs South)",
      color = "AUC"
    ) +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))
}

plot_maf_fst_founder <- function(df, title) {
  ggplot(df, aes(x = pmax(MAF, 0.05), y = Fst_pop, color = pmax(Fst_founder, 0))) +
    geom_point(alpha = 0.7, size = 3.5) +
    geom_smooth(
      method = "lm",
      se = TRUE,
      color = "black",
      linewidth = 1.2
    ) +
    scale_color_gradient2(
      low = "royalblue1",
      mid = "grey70",
      high = "firebrick1",
      midpoint = 0.5,
      limits = c(0, 1),
      oob = scales::squish,
      breaks = c(0, 0.5, 1),
      name = "FST Tsushima/Mainland"
    ) +
    coord_cartesian(xlim = c(0.05, 0.5), ylim = c(0, 1)) +
    theme_minimal(base_size = 13) +
    labs(
      title = title,
      x = "MAF",
      y = "FST (North vs South)"
    ) +
    theme(plot.title = element_text(hjust = 0.5, face = "bold"))
}

