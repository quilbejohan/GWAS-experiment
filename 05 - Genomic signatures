# ============================================================
# 5B. Heatmaps of SNP categories by accession
# ============================================================

compute_panel_af <- function(SNP_matrix, snps, meta_cols = c("CHR", "POS", "snp_id")) {
  sub <- SNP_matrix %>% filter(snp_id %in% snps)

  if (nrow(sub) == 0) {
    stop("No SNPs found in SNP_matrix for the requested snp_id set.")
  }

  geno_cols <- setdiff(names(sub), meta_cols)
  G <- as.matrix(sub[, geno_cols, drop = FALSE])
  storage.mode(G) <- "numeric"

  ok <- is.finite(G)
  n_nonmiss <- rowSums(ok)
  AN <- 2 * n_nonmiss
  AC_alt <- rowSums(G, na.rm = TRUE)
  AF_alt <- AC_alt / AN

  tibble(
    snp_id = sub$snp_id,
    AF_alt = AF_alt,
    minor_is_alt = AF_alt <= 0.5,
    AN = AN
  )
}

add_minor_encoding <- function(geno_long, af_map, maf_table = NULL) {

  out <- geno_long %>%
    left_join(af_map %>% select(snp_id, minor_is_alt), by = "snp_id")

  if (!is.null(maf_table)) {
    out <- out %>%
      left_join(maf_table %>% select(snp_id, MAF), by = "snp_id")
  } else {
    out <- out %>%
      left_join(af_map %>% select(snp_id, AF_alt), by = "snp_id") %>%
      mutate(MAF = pmin(AF_alt, 1 - AF_alt))
  }

  out %>%
    mutate(
      g = as.numeric(genotype),
      minor_dosage = case_when(
        !is.finite(g) | is.na(minor_is_alt) ~ NA_real_,
        minor_is_alt ~ g,
        TRUE ~ 2 - g
      ),
      minor_present = as.integer(minor_dosage > 0)
    )
}

plot_heatmap_category <- function(SNP_categories,
                                  label_name,
                                  SNP_matrix,
                                  accession_meta,
                                  title = NULL,
                                  value = c("binary", "dosage"),
                                  order_accessions = TRUE,
                                  order_snps_by = c("MAF", "none")) {

  value <- match.arg(value)
  order_snps_by <- match.arg(order_snps_by)

  sample_cols <- setdiff(names(SNP_matrix), c("CHR", "POS", "snp_id"))

  accession_meta <- accession_meta %>%
    filter(accession %in% sample_cols)

  snps <- SNP_categories %>%
    filter(label == label_name) %>%
    pull(snp_id) %>%
    unique()

  if (length(snps) == 0) {
    stop("No SNPs found for label: ", label_name)
  }

  SNP_sub <- SNP_matrix %>%
    filter(snp_id %in% snps) %>%
    select(snp_id, all_of(sample_cols))

  geno_long <- SNP_sub %>%
    pivot_longer(cols = -snp_id, names_to = "accession", values_to = "genotype") %>%
    left_join(accession_meta %>% select(accession, lat), by = "accession")

  af_map <- compute_panel_af(SNP_matrix, snps)

  maf_table <- SNP_categories %>%
    filter(label == label_name) %>%
    select(snp_id, MAF) %>%
    distinct()

  geno_long2 <- add_minor_encoding(geno_long, af_map, maf_table)

  if (order_accessions) {
    accession_order <- accession_meta %>%
      distinct(accession, lat) %>%
      arrange(lat, accession) %>%
      pull(accession)

    geno_long2 <- geno_long2 %>%
      mutate(accession = factor(accession, levels = accession_order))
  }

  if (order_snps_by == "MAF") {
    snp_order <- geno_long2 %>%
      distinct(snp_id, MAF) %>%
      arrange(MAF, snp_id) %>%
      pull(snp_id)

    geno_long2 <- geno_long2 %>%
      mutate(snp_id = factor(snp_id, levels = snp_order))
  }

  if (value == "binary") {
    p <- ggplot(geno_long2, aes(x = accession, y = snp_id, fill = factor(minor_present))) +
      geom_tile() +
      scale_fill_manual(
        values = c("0" = "#440154FF", "1" = "#FDE725FF"),
        breaks = c("0", "1"),
        labels = c("Major allele", "Minor allele"),
        name = "Allele state"
      )
  } else {
    p <- ggplot(geno_long2, aes(x = accession, y = snp_id, fill = minor_dosage)) +
      geom_tile() +
      scale_fill_viridis_c(name = "Minor dosage", limits = c(0, 2))
  }

  if (is.null(title)) {
    title <- label_name
  }

  p +
    theme_minimal(base_size = 12) +
    theme(
      axis.text = element_blank(),
      axis.title = element_blank(),
      axis.ticks = element_blank(),
      panel.grid = element_blank(),
      plot.title = element_text(hjust = 0.5, face = "bold")
    ) +
    labs(title = title)
}

