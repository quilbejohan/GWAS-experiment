#     - MAF vs FST scatter plots
#     - AUC_LOESS- and FST_founder-colored scatter plots
#     - SNP-by-accession heatmaps by SNP category
#
# Main inputs:
#   - SNP_categories_all_metrics.csv
#   - Lj_accessions_SNPs.csv
#   - LotusSNP_accessions_location.csv
# ============================================================

suppressPackageStartupMessages({
